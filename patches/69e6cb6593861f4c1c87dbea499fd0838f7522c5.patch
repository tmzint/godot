From 7657a34e1902fefa59690c91f6cdf48357b81d40 Mon Sep 17 00:00:00 2001
From: Joseph <jgoyer3@gmail.com>
Date: Thu, 7 May 2026 17:56:45 -0400
Subject: [PATCH 3/4] update viewport preserve_alpha documention with
 suggestions from copilot

---
 doc/classes/Viewport.xml | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/doc/classes/Viewport.xml b/doc/classes/Viewport.xml
index 835960c06aa9..200935feb0d6 100644
--- a/doc/classes/Viewport.xml
+++ b/doc/classes/Viewport.xml
@@ -471,8 +471,9 @@
 			Practically speaking, this means that the end result of the Viewport will not be clamped to the [code]0-1[/code] range and can be used in 3D rendering without color encoding adjustments. This allows 2D rendering to take advantage of effects requiring high dynamic range (e.g. 2D glow) as well as substantially improves the appearance of effects requiring highly detailed gradients.
 		</member>
 		<member name="preserve_alpha" type="bool" setter="set_preserve_alpha" getter="get_preserve_alpha" default="false">
-			If [code]true[/code], the alpha channel will be preserved when passed into shaders.
-			[b]Note:[/b] Setting this to [code]true[/code] may break behavior.
+			If [code]true[/code], the viewport texture's alpha channel is preserved when sampled in shaders instead of being treated as fully opaque.
+ 			[b]Note:[/b] Enabling this changes the default alpha behavior of viewport textures and can break materials or shaders that assume the sampled alpha is always [code]1.0[/code]. It can also change blending and compositing results when the viewport texture is drawn over other content, especially if [member transparent_bg] is [code]true[/code].
+ 			This is intended for cases where the viewport's actual transparency information must be kept, such as compositing the viewport over another image or using its alpha data directly in a shader.ha channel will be preserved when passed into shaders, instead of using a constant value of [code]1.0[/code] for every pixel.
 		</member>
 		<member name="use_occlusion_culling" type="bool" setter="set_use_occlusion_culling" getter="is_using_occlusion_culling" default="false">
 			If [code]true[/code], [OccluderInstance3D] nodes will be usable for occlusion culling in 3D for this viewport. For the root viewport, [member ProjectSettings.rendering/occlusion_culling/use_occlusion_culling] must be set to [code]true[/code] instead.

